DJANGO_SECRET_KEY='django-insecure-municipalidad-laserena-sgr-2026-secret-key'
DEBUG=True
ALLOWED_HOSTS='localhost,127.0.0.1'

# --- Base de datos ----------------------------------------------------------
# Por defecto se usa SQLite: si no defines nada de aqui, la app trabaja con el
# archivo db.sqlite3 del proyecto y no hace falta instalar nada extra.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# MariaDB / MySQL (ejemplo principal para producción EC2):
# descomenta y ajusta estas variables
# (requiere mysqlclient, que esta en requirements.txt).
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=sgr_laserena
# DB_USER=sgr_user
# DB_PASSWORD=pone_aqui_tu_contraseña
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Email ----------------------------------------------------------------
# Backend de correo. Por defecto imprime en consola (el correo con el enlace de
# recuperación aparece en la terminal del servidor). Para la demo y producción
# usa SMTP real (Gmail, ejemplo 2).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Configuración SMTP (solo si usas el backend smtp).
# Ejemplo 1 - Mailtrap (sandbox de pruebas: captura los correos, no los entrega):
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_HOST_USER=tu-usuario-mailtrap
# EMAIL_HOST_PASSWORD=tu-clave-mailtrap
# EMAIL_USE_TLS=True

# Ejemplo 2 - Gmail (RECOMENDADO para la Evaluación 3). Requiere una
# "contraseña de aplicación" de 16 letras (Cuenta de Google > Seguridad >
# Verificación en 2 pasos > Contraseñas de aplicaciones). NO es tu clave normal
# y NUNCA se sube a GitHub (el .env está en .gitignore):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=abcdefghijklmnop
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=SGR La Serena <tu-correo@gmail.com>

# Ejemplo 3 - Mailtrap Sending API (envío real vía django-anymail; requiere
# dominio verificado para enviar a terceros, el dominio demo solo envía al
# correo de registro de la cuenta):
# EMAIL_BACKEND=anymail.backends.mailtrap.EmailBackend
# MAILTRAP_API_TOKEN=tu-api-token-de-mailtrap
# DEFAULT_FROM_EMAIL=hello@demomailtrap.co

# Remitente por defecto para los correos del sistema:
# DEFAULT_FROM_EMAIL=no-reply@sgr.municipalidadla-serena.cl

# --- Recuperación de contraseña (enlace con token) -------------------------
# PASSWORD_RESET_TIMEOUT: vigencia del enlace en SEGUNDOS (1800 = 30 minutos).
# PASSWORD_RESET_TIMEOUT=1800
# SITE_URL: dirección pública para armar el enlace del correo. Opcional: si se
# deja vacía se usa la dirección con que se abrió el sitio (p. ej. la IP de la EC2).
# SITE_URL=http://TU-IP-PUBLICA-EC2